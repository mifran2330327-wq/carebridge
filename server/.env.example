# Backend Environment Variables (D:\carebridge\server\.env)
# Copy this to server/.env and fill in your values

# Database (PostgreSQL)
# For Docker: uses postgres service name
# For local dev: postgresql://user:pass@localhost:5432/carebridge
DATABASE_URL="postgresql://carebridge:carebridge@postgres:5432/carebridge?schema=public"
DIRECT_URL="postgresql://carebridge:carebridge@postgres:5432/carebridge?schema=public"

# Server
PORT=5000

# JWT Secret - generate a secure random string (min 32 chars)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Algolia (Admin keys - NEVER expose to frontend)
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_ADMIN_KEY=your_algolia_admin_api_key
ALGOLIA_INDEX=carebridge_content