# Frontend Environment Variables (D:\carebridge\.env)
# Copy this to .env and fill in your values

# API URL - leave as /api for Docker proxy, or http://localhost:5000/api for local dev
VITE_API_URL=/api

# Algolia Search (public keys only - safe for frontend)
VITE_ALGOLIA_APP_ID=your_algolia_app_id
VITE_ALGOLIA_SEARCH_KEY=your_algolia_search_only_key
VITE_ALGOLIA_INDEX=carebridge_content