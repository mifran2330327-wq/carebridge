# Copy this file to .env and fill in real values. .env is gitignored.

# --- PostgreSQL connection ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=carebridge

# --- Auth ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
